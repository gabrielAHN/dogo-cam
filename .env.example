BASIC_AUTH_USERNAME=your_username
BASIC_AUTH_PASSWORD=your_password
SECRET_KEY=replace_me
MAX_VIEWERS=3
# Camera stream framerate cap. Lower = less CPU/camera current draw (helps
# avoid Pi 3B under-voltage brown-outs). Default 15 is smooth for a pet cam.
STREAM_MAX_FPS=15
# Stall handling. A /video_feed request gives up (and frees its gunicorn
# thread) after this many seconds without a new frame; the UI reconnects.
STREAM_FRAME_TIMEOUT=5
# If the camera produces no frames for this long, the app tears down and
# re-creates the Picamera2 pipeline in-process (no service restart needed).
STREAM_STALL_RESTART_AFTER=20
STREAM_STALL_CHECK_INTERVAL=5
# dogcam-watchdog.sh: only restart the whole service if a stall outlives
# in-process recovery by this much.
STALL_ESCALATE_SECONDS=120

# --- Camera resolution & image quality (NoIR wide-angle OV5647) ---
# Stream resolution. Default 1296x972 uses the wide lens; 640x480 or 800x600
# are lighter. Bench-tested: pixel count barely moves 5V-rail draw at a fixed
# STREAM_MAX_FPS, so the fps cap above is the real power lever, not this.
STREAM_WIDTH=1296
STREAM_HEIGHT=972
# libcamera tuning file. The lens is NoIR (no IR-cut filter): the standard
# ov5647.json leaves daylight heavily magenta; ov5647_noir.json corrects it.
# Set empty to force the sensor default.
CAM_TUNING_FILE=ov5647_noir.json
# Optional ISP image tuning (all clamped to sensor range; unset = ISP default).
CAM_SHARPNESS=1.5          # 0-16
CAM_CONTRAST=              # 0-32 (1.0 = neutral)
CAM_SATURATION=            # 0-32 (1.0 = neutral; 0 = grayscale)
CAM_BRIGHTNESS=            # -1.0 to 1.0
CAM_EV=                    # exposure bias, -8.0 to 8.0
CAM_AWB_MODE=              # auto|incandescent|tungsten|fluorescent|indoor|daylight|cloudy|custom
CAM_NOISE_REDUCTION=fast   # off|fast|high_quality|minimal|zsl

# --- Automatic day / night (NoIR) ---
# Colour by day, grayscale by night (colour is noise under IR in the dark),
# switched off the camera's own AE Lux meter. Two thresholds + a sustained
# time give hysteresis so dusk / passing headlights can't make it flap.
DAYNIGHT_AUTO=1
DAYNIGHT_NIGHT_LUX=5        # below this (sustained) -> night mode (grayscale)
DAYNIGHT_DAY_LUX=12         # above this (sustained) -> day mode; low so any real light = colour
DAYNIGHT_CHECK_INTERVAL=10  # seconds between Lux checks
DAYNIGHT_NIGHT_AFTER=45     # seconds below NIGHT_LUX before going grayscale (lazy)
DAYNIGHT_DAY_AFTER=8        # seconds above DAY_LUX before going colour (eager)
# Light-adaptive tuning: saturation scales with lux (IR false colour under
# artificial light gets amplified by saturation, so damp it when dim).
CAM_SAT_BRIGHT=1.0          # saturation in real daylight
CAM_SAT_DIM=0.7             # saturation at the day/night edge
CAM_BRIGHT_LUX=400          # lux considered real daylight
NIGHT_MAX_FPS=6             # night fps cap: longer exposure = real sensitivity, less power
CAM_NIGHT_EV_MAX=1.0        # EV bias at total darkness, scaled to 0 at NIGHT_LUX
DAYNIGHT_MODE=auto          # startup / manual override: auto|day|night

# --- Digital zoom (ScalerCrop; counteract the wide lens, frame the dog) ---
CAM_ZOOM=1.0               # startup zoom (1.0 = full field of view)
CAM_ZOOM_MAX=4.0           # max zoom the /camera/zoom endpoint allows

PORT=5000
DOG_NAME=Kotaro
DOGCAM_CAMERA_VIEW=normal
SWITCH_MODE=auto
SWITCH_PIN=17
SWITCH_ON_VALUE=0
SWITCH_LOG_INTERVAL=10
SWITCH_RECONCILE_INTERVAL=5
SERVO_STEP_SIZE=10
SERVO_SETTLE_SECONDS=0.25
SERVO_MIN_MOVEMENT_INTERVAL=0.01
ENABLE_CLOUDFLARED=1
CLOUDFLARED_CONFIG=/home/your-user/.cloudflared/config.yml
CLOUDFLARED_TUNNEL=dog-stream-tunnel
TRUST_PROXY_HEADERS=0
TRUST_PROXY_PREFIX_HEADERS=0
TRUST_PROXY_AUTH_HEADERS=0
DOGCAM_CONTROL_GROUPS=admin,admins,dogo_operators
DOGCAM_HOME_URL=/
DOGCAM_AUTH_SETTINGS_URL=
DOGCAM_LOGOUT_URL=

# Temperature source: sensor (local DHT22) or ha (Home Assistant API)
TEMP_SOURCE=sensor
# Home Assistant settings (used when TEMP_SOURCE=ha)
HA_URL=http://your-ha-host:8123
HA_TOKEN=your-long-lived-access-token
HA_TEMP_ENTITY=sensor.your_temperature_entity
HA_HUMIDITY_ENTITY=sensor.your_humidity_entity
