BASIC_AUTH_USERNAME=your_username
BASIC_AUTH_PASSWORD=your_password
SECRET_KEY=replace_me
MAX_VIEWERS=3
# Camera stream framerate cap. Lower = less CPU/camera current draw (helps
# avoid Pi 3B under-voltage brown-outs). Default 15 is smooth for a pet cam.
STREAM_MAX_FPS=15
# Stall handling. A /video_feed request gives up (and frees its gunicorn
# thread) after this many seconds without a new frame; the UI reconnects.
STREAM_FRAME_TIMEOUT=5
# If the camera produces no frames for this long, the app tears down and
# re-creates the Picamera2 pipeline in-process (no service restart needed).
STREAM_STALL_RESTART_AFTER=20
STREAM_STALL_CHECK_INTERVAL=5
# dogcam-watchdog.sh: only restart the whole service if a stall outlives
# in-process recovery by this much.
STALL_ESCALATE_SECONDS=120

PORT=5000
DOG_NAME=Kotaro
DOGCAM_CAMERA_VIEW=normal
SWITCH_PIN=17
SWITCH_ON_VALUE=0
SWITCH_LOG_INTERVAL=10
SWITCH_RECONCILE_INTERVAL=5
SERVO_STEP_SIZE=10
SERVO_SETTLE_SECONDS=0.25
SERVO_MIN_MOVEMENT_INTERVAL=0.01
ENABLE_CLOUDFLARED=1
CLOUDFLARED_CONFIG=/home/your-user/.cloudflared/config.yml
CLOUDFLARED_TUNNEL=dog-stream-tunnel
TRUST_PROXY_HEADERS=0
TRUST_PROXY_PREFIX_HEADERS=0
TRUST_PROXY_AUTH_HEADERS=0
DOGCAM_CONTROL_GROUPS=admin,admins,dogo_operators
DOGCAM_HOME_URL=/
DOGCAM_AUTH_SETTINGS_URL=
DOGCAM_LOGOUT_URL=

# Temperature source: sensor (local DHT22) or ha (Home Assistant API)
TEMP_SOURCE=sensor
# Home Assistant settings (used when TEMP_SOURCE=ha)
HA_URL=http://your-ha-host:8123
HA_TOKEN=your-long-lived-access-token
HA_TEMP_ENTITY=sensor.your_temperature_entity
HA_HUMIDITY_ENTITY=sensor.your_humidity_entity
