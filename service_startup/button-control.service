[Unit]
Description=KY-004 Button Control (Start Service & Shutdown)
After=multi-user.target

[Service]
Type=simple
User=your-user
WorkingDirectory=/home/your-user/dogo-cam
EnvironmentFile=-/home/your-user/dogo-cam/.env
# The project venv (uv sync / pip install -r requirements.txt) has paho-mqtt;
# the system python3 does not.
ExecStart=/home/your-user/dogo-cam/.venv/bin/python /home/your-user/dogo-cam/ky004-control.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
